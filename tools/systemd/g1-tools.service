[Unit]
Description=G1 TTS web server, SLAM relocation, and wireless controller at boot
Documentation=file:///home/unitree/workspace/dockerws/g1_ws_jazzy/tools/systemd/g1-tools-start.sh
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/workspace/dockerws/g1_ws_jazzy/tools
EnvironmentFile=/home/unitree/workspace/dockerws/g1_ws_jazzy/tools/systemd/g1-tools.env
ExecStart=/home/unitree/workspace/dockerws/g1_ws_jazzy/tools/systemd/g1-tools-start.sh
Restart=on-failure
RestartSec=5
# Merge stdout and stderr so shell + all Python children land in one file.
StandardOutput=append:/home/unitree/workspace/dockerws/g1_ws_jazzy/logs/g1-tools.log
StandardError=append:/home/unitree/workspace/dockerws/g1_ws_jazzy/logs/g1-tools.log

[Install]
WantedBy=multi-user.target
