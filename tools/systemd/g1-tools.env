# Shared environment for G1 tool services (systemd does not load ~/.bashrc).
PYTHONPATH=/home/unitree/workspace/unitree_sdk2_python:/home/unitree/workspace/dockerws/g1_ws_jazzy/nodes
# Flush print() from background Python children into the systemd log immediately.
PYTHONUNBUFFERED=1

# ROS 2 Foxy + Cyclone DDS (required for odom verification and controller node).
ROS_SETUP=/opt/ros/foxy/setup.bash
CYCLONEDDS_SETUP=/home/unitree/cyclonedds_ws/install/setup.bash
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=/home/unitree/cyclonedds_ws/cyclonedds.xml

# Wait this many seconds after systemd starts the service (post boot) before
# launching TTS, SLAM relocation, and the wireless controller.
G1_BOOT_DELAY_SEC=120

# Docker Nav2 stack (started only after successful SLAM relocation).
G1_DOCKER_CONTAINER=cp2-jazzy
G1_DOCKER_WS_DIR=/workspace/g1_ws_jazzy
G1_DOCKER_BASHRC=/root/.bashrc

# Nav2 verification (poll ROS domain 1 topics inside Docker after startnav2.sh).
G1_NAV2_ROS_DOMAIN_ID=1
G1_NAV2_VERIFY_TIMEOUT_SEC=180
G1_NAV2_VERIFY_INTERVAL_SEC=5
G1_NAV2_REQUIRED_TOPICS="/unitree/odom /utlidar/pcl2 /map /cmd_vel /lifecycle_manager_navigation/managed_nodes_activated"
G1_NAV2_READY_SPEAK_TEXT=Nav2 stack ready
G1_NAV2_FAIL_SPEAK_TEXT=Nav2 stack failed to start

# Handshake HTTP server (conda env tv).
G1_HANDSHAKE_DIR=/home/unitree/workspace/teleoperate/handshake
G1_HANDSHAKE_PYTHON=/home/unitree/anaconda3/envs/tv/bin/python
G1_HANDSHAKE_PORT=5000

# Spoken after wireless controller starts.
G1_CONTROLLER_SPEAK_TEXT=Wireless controller started

# Spoken after wireless controller + handshake server are both ready.
G1_READY_SPEAK_TEXT=G1 tools ready, controller and handshake started
