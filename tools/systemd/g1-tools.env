# Shared environment for G1 tool services (systemd does not load ~/.bashrc).
PYTHONPATH=/home/unitree/workspace/unitree_sdk2_python:/home/unitree/workspace/dockerws/g1_ws_jazzy/nodes

# Wait this many seconds after systemd starts the service (post boot) before
# launching TTS, SLAM relocation, and the wireless controller.
G1_BOOT_DELAY_SEC=120
