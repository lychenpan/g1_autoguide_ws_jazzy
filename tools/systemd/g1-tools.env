# Shared environment for G1 tool services (systemd does not load ~/.bashrc).
PYTHONPATH=/home/unitree/workspace/unitree_sdk2_python:/home/unitree/workspace/dockerws/g1_ws_jazzy/nodes
# Flush print() from background Python children into the systemd log immediately.
PYTHONUNBUFFERED=1

# ROS 2 Foxy + Cyclone DDS (sourced in g1-tools-start.sh for unitree_controller_node).
ROS_SETUP=/opt/ros/foxy/setup.bash
CYCLONEDDS_SETUP=/home/unitree/cyclonedds_ws/install/setup.bash

# Wait this many seconds after systemd starts the service (post boot) before
# launching TTS, SLAM relocation, and the wireless controller.
G1_BOOT_DELAY_SEC=30 #TODO to check
