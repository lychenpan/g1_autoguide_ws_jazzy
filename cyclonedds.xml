<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">

    <Domain Id="0">
        <General>
            <AllowMulticast>spdp</AllowMulticast>
            <Interfaces>
                <NetworkInterface name="eth0" priority="default" multicast="default" />
            </Interfaces>
        </General>
        <Internal>
            <SocketSendBufferSize min="2 MiB" max="8 MiB" />
            <SocketReceiveBufferSize min="2 MiB" max="8 MiB" />
        </Internal>
    </Domain>

    <Domain Id="1">
        <General>
            <AllowMulticast>spdp</AllowMulticast>
            <Interfaces>
                <NetworkInterface name="wlan0" priority="default" multicast="default" />
            </Interfaces>
        </General>
        <Internal>
            <SocketSendBufferSize min="2 MiB" max="8 MiB" />
            <SocketReceiveBufferSize min="2 MiB" max="8 MiB" />
        </Internal>
    </Domain>

</CycloneDDS>
